{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"declaration": true,
		"strict": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"perkslab-ui": [
				"./src/index.ts"
			]
		},
		"baseUrl": "."
	},
	"include": [
		"src",
		"stories"
	],
	"exclude": [
		"dist"
	]
}
